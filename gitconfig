[user]
  name = Eric Brunson
  email = eric.brunson@oracle.com
[push]
  default = simple
[alias]
  l = log --name-status
  tree = log --graph --decorate --pretty=oneline --abbrev-commit
  hist = log --pretty=format:\"%Cgreen%h%Creset %Cblue%ad%Creset %s%C(yellow)%d%Creset %Cblue[%an]%Creset\" --graph --date=short
  branches = "!git for-each-ref refs/heads --format='%(refname)' | cut -d/ -f3"
  cleanup = "!git branch --merged | grep  -v '\\*\\|main\\|develop' | xargs -n 1 git branch -d"
  amend = commit --amend -CHEAD
  bdiff = log --left-right --graph --cherry-pick --pretty='%C(auto) %h %d%Cblue %ad%Cred %aN %Creset%s'
  chhist = log --follow -p -- 
  stash-untracked = "!f() {  \
    git stash;       \
    git stash -u;    \
    git stash pop stash@{1}; \
  }; f"
	graph = log --all --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ci) %C(bold blue)<%an>%Creset'
[pull]
	ff = only
[init]
	defaultBranch = master
[rerere]
	enabled = true
[color]
	ui = auto
